{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".wxt/types/**/*.d.ts"],
  "exclude": [".output", "node_modules"]
}
